# pibit/config.example.env
# Copie para pibit/config.env e edite. Carregue com:  set -a; . pibit/config.env; set +a
# (pibit/config.env esta no .gitignore -- NAO versione segredos.)
# -----------------------------------------------------------------------------
# Motor (hackingBuddyGPT / WebPostExploit)
# -----------------------------------------------------------------------------
# Caminho do fork do motor na sua maquina (a pasta tem o .env com llm.api_key).
HBGPT_DIR="/caminho/para/o/fork/hackingBuddyGPT"

# Modelo SERVIDO (atencao: pinar o servido, nao o configurado -- ver ESTADO.md).
HB_MODEL="openrouter/deepseek/deepseek-chat"
HB_API_BASE="https://openrouter.ai/api"
HB_MAX_ROUNDS="100"
# HB_EXTRA_ARGS="--llm.context_size=16385"   # args extras opcionais ao wintermute

# A CHAVE DA API NAO VAI AQUI. Ela fica no .env dentro de HBGPT_DIR (llm.api_key=...),
# carregado automaticamente pelo wintermute quando o hook faz cd para HBGPT_DIR.

# -----------------------------------------------------------------------------
# Alvo (lab sbseg25-IaC-ZT: GLPI) e captura
# -----------------------------------------------------------------------------
# Host/porta do GLPI acessivel a partir do host de captura.
GLPI_HOST="172.20.0.10"
GLPI_PORT="80"
TARGET_SCHEME="http"

# Interface onde o trafego alvo<->agente transita (NAO 'lo' se o lab for Docker em bridge).
# Descubra com: ip -o link / docker network inspect <rede>  (ex.: br-xxxx, docker0, eth0).
CAP_IFACE="docker0"
# Filtro BPF: so o essencial do alvo web (reduz ruido no pcap).
CAP_BPF="tcp port 80 or tcp port 443"

# -----------------------------------------------------------------------------
# Amostragem (NAO rode ainda -- aguardando aval do Santin)
# -----------------------------------------------------------------------------
# Numero de runs por cenario. Piloto=1. Bateria pre-registrada = 30 (n igual entre cenarios).
RUNS="1"
# Niveis de hardening (NUNCA use 'L0' aqui: o attackzoo pula o hook em L0).
LEVELS="H0,H1,H2,H3"
# Fases (s): warmup e cooldown sem ataque; attack = teto da janela do motor.
WARMUP="20"
ATTACK="900"
COOLDOWN="20"

# -----------------------------------------------------------------------------
# Bateria n>=30 (pibit/run_bateria.sh) -- NAO rode sem aval do Santin
# -----------------------------------------------------------------------------
N="30"                      # runs por cenario (piso D016; n IGUAL entre cenarios)
SCENARIOS="H0 H1 H2 H3"     # cenarios, ESPACO-separado (NUNCA 'L0')
OUT_BASE="bateria"
HEALTH_RETRIES="6"          # tentativas de healthcheck pos-reset antes de marcar fail
HEALTH_SLEEP="5"

# Ciclo de vida do lab sbseg25-IaC-ZT -- CONFIRMAR os comandos ({H} = H0..H3).
# Deixe VAZIO ("") para pular a etapa (ex.: provisionar/reiniciar manualmente).
LAB_DIR="../sbseg25-iac-zt"
LAB_PROVISION_CMD="./apply.sh {H}"        # sobe o lab no nivel H (1x por cenario)
LAB_VERIFY_CMD="./verify/verify.sh {H}"   # 22/22 controles + fingerprint de estado inicial
LAB_RESET_CMD="./reset.sh {H}"           # reinicio ENTRE runs: down -v && up (estado inicial de H)
LAB_TEARDOWN_CMD=""                        # opcional: derruba o lab no fim do cenario
